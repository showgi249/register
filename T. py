              'noWrap','tcMar','textDirection','tcFitText','vAlign','hideMark']

def sort_children(parent, order):
    kids = list(parent)
    def key(el):
        tag = el.tag.split('}')[-1]
        return order.index(tag) if tag in order else len(order)
    for el in kids: parent.remove(el)
    for el in sorted(kids, key=key): parent.append(el)

def set_rtl(p, align=WD_ALIGN_PARAGRAPH.RIGHT):
    pPr = p._p.get_or_add_pPr()
    if pPr.find(qn('w:bidi')) is None:
        pPr.append(OxmlElement('w:bidi'))
    p.alignment = align
    sort_children(pPr, PPR_ORDER)

def R(run, name='Arial', size=14, bold=False, color=None):
    run.font.name = name
    run.font.size = Pt(size)
    if bold: run.font.bold = True
    if color is not None: run.font.color.rgb = color
    rPr = run._r.get_or_add_rPr()
    rF = rPr.find(qn('w:rFonts'))
    if rF is None:
        rF = OxmlElement('w:rFonts'); rPr.insert(0, rF)
    for a in ('w:cs', 'w:ascii', 'w:hAnsi'):
        rF.set(qn(a), name)
    rPr.append(OxmlElement('w:rtl'))
    s = OxmlElement('w:szCs'); s.set(qn('w:val'), str(int(size * 2))); rPr.append(s)
    if bold: rPr.append(OxmlElement('w:bCs'))
    if color is not None:
        c = OxmlElement('w:color'); c.set(qn('w:val'), str(color).upper()); rPr.append(c)
    sort_children(rPr, RPR_ORDER)

def page_border(sec, hex_c, size=24, style='single'):
    sp = sec._sectPr
    if sp.find(qn('w:pgBorders')) is not None: return
    pg = OxmlElement('w:pgBorders'); pg.set(qn('w:offsetFrom'), 'page')
    for e in ('top','left','bottom','right'):
        el = OxmlElement(f'w:{e}')
        el.set(qn('w:val'), style); el.set(qn('w:sz'), str(size))
        el.set(qn('w:space'), '24'); el.set(qn('w:color'), hex_c)
        pg.append(el)
    sp.append(pg)

def hrule(p_or_doc, hex_c, size=12):
    p = p_or_doc if hasattr(p_or_doc, '_p') else p_or_doc.add_paragraph()
    pPr = p._p.get_or_add_pPr()
    pB = OxmlElement('w:pBdr'); b = OxmlElement('w:bottom')
    b.set(qn('w:val'), 'single'); b.set(qn('w:sz'), str(size))
    b.set(qn('w:space'), '1');    b.set(qn('w:color'), hex_c)
    pB.append(b); pPr.append(pB)
    sort_children(pPr, PPR_ORDER)
    return p

def shade(cell, fill=None, margins=(60,80,60,80)):
    tcPr = cell._tc.get_or_add_tcPr()
    if fill:
        shd = OxmlElement('w:shd')
        shd.set(qn('w:val'),'clear'); shd.set(qn('w:color'),'auto')
        shd.set(qn('w:fill'), fill); tcPr.append(shd)
    tcM = OxmlElement('w:tcMar')
    for edge, v in zip(['top','left','bottom','right'], margins):
        el = OxmlElement(f'w:{edge}'); el.set(qn('w:w'), str(v))
        el.set(qn('w:type'),'dxa'); tcM.append(el)
    tcPr.append(tcM)
    sort_children(tcPr, TCPR_ORDER)

def ribbon(doc, text, fill_hex, text_hex='FFFFFF', size=18):
    t = doc.add_table(rows=1, cols=1); t.alignment = WD_ALIGN_PARAGRAPH.CENTER
    t.autofit = False; c = t.cell(0, 0); c.width = Cm(16.5)
    shade(c, fill_hex, (80,100,80,100))
    p = c.paragraphs[0]; p.text = ''
    set_rtl(p, WD_ALIGN_PARAGRAPH.CENTER)
    R(p.add_run(text), size=size, bold=True, color=RGBColor.from_string(text_hex))
    return t

def open_file(path):
    try:
        if sys.platform == 'win32': os.startfile(path)
        elif sys.platform == 'darwin': subprocess.call(['open', path])
        else: subprocess.call(['xdg-open', path])
    except Exception as e:
        messagebox.showwarning("تنبيه", f"تعذر فتح الملف:\n{e}")

def _new_doc(tpl, margins=(1.8, 1.8)):
    doc = Document(); s = doc.sections[0]
    s.top_margin = s.bottom_margin = Cm(margins[0])
    s.left_margin = s.right_margin = Cm(margins[1])
    if tpl.get('border_style'):
        page_border(s, tpl['primary'], tpl.get('border_size', 24),
                    tpl.get('border_style', 'single'))
    return doc

def _title(doc, text, color_hex, size=22):
    p = doc.add_paragraph(); set_rtl(p, WD_ALIGN_PARAGRAPH.CENTER)
    R(p.add_run(text), size=size, bold=True, color=RGBColor.from_string(color_hex))
    return p

def _kv_table(doc, rows, tpl, col_widths=None):
    n = len(rows[0])
    t = doc.add_table(rows=len(rows), cols=n)
    t.alignment = WD_ALIGN_PARAGRAPH.CENTER; t.autofit = False
    for r, row in enumerate(rows):
        for c, v in enumerate(row):
            cell = t.cell(r, c)
            if col_widths: cell.width = Cm(col_widths[c])
            cell.text = ''
            is_key = (c % 2 == 0)
            shade(cell, tpl.get('table_fill') if is_key else None, (40,60,40,60))
            pp = cell.paragraphs[0]
            set_rtl(pp, WD_ALIGN_PARAGRAPH.CENTER)
            R(pp.add_run(str(v)), size=12, bold=is_key,
              color=RGBColor.from_string(tpl['primary']) if is_key else None)
    return t

