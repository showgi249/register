    school   = f('المدرسة:', 'مدرسة الأمل', 0, 0); subject  = f('المادة:', 'الرياضيات', 0, 2)
    grade    = f('الصف:', 'السادس', 1, 0); duration = f('المدة:', 'ساعتان', 1, 2)
    date     = f('التاريخ:', datetime.now().strftime('%Y-%m-%d'), 2, 0); total    = f('الدرجة الكلية:', '100', 2, 2)
    qp = QuestionsPanel(parent); qp.grid(row=3, column=0, columnspan=4, sticky='we', pady=6)
    def get_data():
        if not qp.questions: messagebox.showwarning('تنبيه', 'أضف سؤالاً.'); return None
        return {'school': school.get(), 'subject': subject.get(), 'grade': grade.get(), 'duration': duration.get(), 'date': date.get(), 'total': total.get(), 'questions': qp.questions}
    return get_data

