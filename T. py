def draw_preview(canvas, tpl, kind):
    w, h = 110, 150
    canvas.delete('all')
    pr = '#' + tpl['primary']; ac = '#' + tpl['accent']
    canvas.create_rectangle(0, 0, w, h, fill='white', outline='#ccc')
    if kind == 'cert':
        canvas.create_rectangle(6, 6, w-6, h-6, outline=pr, width=2)
        if tpl['border_style'] == 'double':
            canvas.create_rectangle(10, 10, w-10, h-10, outline=pr, width=1)
        if tpl.get('title_bar'):
            canvas.create_rectangle(18, 22, w-18, 38, fill=pr, outline='')
        else:
            canvas.create_line(22, 32, w-22, 32, fill=pr, width=3)
        canvas.create_line(28, 48, w-28, 48, fill=ac, width=2)
        for y in [60, 72, 84]:
            canvas.create_line(16, y, w-16, y, fill='#aaa')
        if tpl['name_style'] == 'bar':
            canvas.create_rectangle(18, 98, w-18, 112, fill=pr, outline='')
        else:
            canvas.create_line(18, 110, w-18, 110, fill=pr, width=2)
        canvas.create_line(18, 126, w//2-2, 126, fill='#aaa')
        canvas.create_line(w//2+2, 126, w-18, 126, fill='#aaa')
        canvas.create_line(28, h-10, w-28, h-10, fill=ac, width=2)
    elif kind in ('record', 'exam', 'letter'):
        canvas.create_rectangle(6, 6, w-6, h-6, outline=pr, width=2)
        if kind == 'letter':
            canvas.create_line(14, 14, w-14, 14, fill=pr, width=2)
            canvas.create_line(14, 20, w-14, 20, fill=ac, width=1)
            for y in range(30, h-22, 8):
                canvas.create_line(14, y, w-14, y, fill='#eee')
            canvas.create_line(14, h-16, w-14, h-16, fill=ac, width=1)
        else:
            canvas.create_rectangle(12, 12, w-12, 26, fill=pr, outline='')
            canvas.create_line(w//2-18, 34, w//2+18, 34, fill=ac, width=2)
            for y in range(44, h-18, 10):
                canvas.create_line(14, y, w-14, y, fill='#ddd')
            if kind == 'record':
                for y in [44, 54, 64, 74, 84, 94, 104, 114]:
                    canvas.create_line(14, y, w-14, y, fill='#999')

def make_card(parent, tpl, kind, on_select):
    f = tk.Frame(parent, bg='white', highlightbackground='#d0d0d0', highlightthickness=2)
    c = tk.Canvas(f, width=110, height=150, bg='white', highlightthickness=0)
    c.pack(padx=6, pady=(6, 2))
    draw_preview(c, tpl, kind)
    lbl = tk.Label(f, text=tpl['name'], bg='white', font=('Arial', 9, 'bold'), fg='#333')
    lbl.pack(pady=(0, 6))
    for w in (f, c, lbl):
        w.bind('<Button-1>', lambda e: on_select(tpl, f))
        w.bind('<Enter>', lambda e: f.configure(cursor='hand2'))
    return f

