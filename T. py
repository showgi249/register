def _exam_header(doc, d, tpl):
    pr = RGBColor.from_string(tpl['primary']); ac = RGBColor.from_string(tpl['accent'])
    st = tpl['header_style']
    if st == 'bar':
        ribbon(doc, d['school'], tpl['primary'], 'FFFFFF', 18)
        p = doc.add_paragraph(); set_rtl(p, WD_ALIGN_PARAGRAPH.CENTER)
        p.paragraph_format.space_before = Pt(6)
        R(p.add_run('ورقة امتحان'), size=22, bold=True, color=ac)
        hrule(doc, tpl['primary'], 12)
    elif st == 'double':
        hrule(doc, tpl['primary'], 6); hrule(doc, tpl['primary'], 18)
        _title(doc, d['school'], tpl['primary'], 18)
        _title(doc, 'ورقة امتحان', tpl['accent'])
        hrule(doc, tpl['primary'], 18); hrule(doc, tpl['primary'], 6)
    else:
        _title(doc, d['school'], tpl['primary'], 18)
        _title(doc, 'ورقة امتحان', tpl['accent'])
        hrule(doc, tpl['primary'], 12)
    _kv_table(doc, [
        ('المادة', d['subject'], 'الصف', d['grade']),
        ('المدة', d['duration'], 'التاريخ', d['date']),
    ], tpl, [4, 4.2, 4, 4.2])
    doc.add_paragraph()
    p = doc.add_paragraph(); set_rtl(p)
    R(p.add_run('اسم الطالب: ___________________'), size=13)
    R(p.add_run('     رقم الجلوس: _________'), size=13)
    R(p.add_run(f"     الدرجة الكلية: {d['total']}"), size=13, bold=True, color=pr)
    hrule(doc, tpl['primary'], 8)

def _render_questions(doc, questions, tpl, show_answers=False, letters='أبجدهوزحط'):
    pr = RGBColor.from_string(tpl['primary']); ac = RGBColor.from_string(tpl['accent'])
    for i, q in enumerate(questions, 1):
        p = doc.add_paragraph(); set_rtl(p)
        p.paragraph_format.space_before = Pt(10)
        R(p.add_run(f'السؤال {i}: '), size=13, bold=True, color=pr)
        R(p.add_run(q['text']), size=13, bold=True)
        R(p.add_run(f"   ({q['marks']})"), size=12, bold=True, color=ac)
        if q['type'] == 'mcq':
            for j, opt in enumerate(q['options']):
                pp = doc.add_paragraph(); set_rtl(pp)
                pp.paragraph_format.right_indent = Cm(1)
                R(pp.add_run(f"({letters[j]}) {opt}"), size=12)
            if show_answers:
                ans = q.get('answer', 0)
                pp = doc.add_paragraph(); set_rtl(pp)
                pp.paragraph_format.right_indent = Cm(1)
                R(pp.add_run(f"الإجابة الصحيحة: ({letters[ans]}) {q['options'][ans]}"),
                  size=12, bold=True, color=RGBColor(0x00, 0x80, 0x00))
        else:
            for _ in range(q.get('lines', 3)):
                pp = doc.add_paragraph(); set_rtl(pp)
                pp.paragraph_format.right_indent = Cm(0.5)
                R(pp.add_run('_' * 60), size=11, color=RGBColor(0x99,0x99,0x99))
            if show_answers and q.get('model_answer'):
                pp = doc.add_paragraph(); set_rtl(pp)
                R(pp.add_run('الإجابة النموذجية: ' + q['model_answer']),
                  size=12, bold=True, color=RGBColor(0x00, 0x80, 0x00))

def build_exam(d, tpl):
    doc = _new_doc(tpl)
    _exam_header(doc, d, tpl)
    _render_questions(doc, d['questions'], tpl, show_answers=False)
    p = doc.add_paragraph(); set_rtl(p, WD_ALIGN_PARAGRAPH.CENTER)
    p.paragraph_format.space_before = Pt(20)
    R(p.add_run('— انتهت الأسئلة — بالتوفيق والنجاح —'),
      size=12, bold=True, color=RGBColor.from_string(tpl['primary']))
    return doc

def build_answer_key(d, tpl):
    doc = _new_doc(tpl)
    _exam_header(doc, d, tpl)
    # Replace title
    p = doc.add_paragraph(); set_rtl(p, WD_ALIGN_PARAGRAPH.CENTER)
    R(p.add_run('★  نموذج الإجابة النموذجية  ★'),
      size=18, bold=True, color=RGBColor.from_string(tpl['accent']))
    hrule(doc, tpl['primary'], 8)
    _render_questions(doc, d['questions'], tpl, show_answers=True)
    return doc

def build_omr(d, tpl):
    doc = _new_doc(tpl)
    _exam_header(doc, d, tpl)
    p = doc.add_paragraph(); set_rtl(p, WD_ALIGN_PARAGRAPH.CENTER)
    R(p.add_run('ورقة إجابة (املأ الدائرة المناسبة)'),
      size=16, bold=True, color=RGBColor.from_string(tpl['accent']))
    doc.add_paragraph()
    # Table: # | Question short | أ | ب | ج | د
    n = len(d['questions'])
    t = doc.add_table(rows=n + 1, cols=6)
    t.alignment = WD_ALIGN_PARAGRAPH.CENTER; t.autofit = False
    headers = ['#', 'السؤال', 'أ', 'ب', 'ج', 'د']
    widths = [1, 8, 1.5, 1.5, 1.5, 1.5]
    for c, (h, w) in enumerate(zip(headers, widths)):
        cell = t.cell(0, c); cell.width = Cm(w); cell.text = ''
        shade(cell, tpl['primary'], (60,40,60,40))
        pp = cell.paragraphs[0]; set_rtl(pp, WD_ALIGN_PARAGRAPH.CENTER)
        R(pp.add_run(h), size=12, bold=True, color=RGBColor(0xFF,0xFF,0xFF))
    for i, q in enumerate(d['questions'], 1):
        row = t.rows[i]
        cell0 = row.cells[0]; cell0.width = Cm(1); cell0.text = ''
        pp = cell0.paragraphs[0]; set_rtl(pp, WD_ALIGN_PARAGRAPH.CENTER)
        R(pp.add_run(str(i)), size=12, bold=True, color=RGBColor.from_string(tpl['primary']))
        cell1 = row.cells[1]; cell1.width = Cm(8); cell1.text = ''
        pp = cell1.paragraphs[0]; set_rtl(pp)
        R(pp.add_run(q['text'][:60]), size=11)
        for j in range(4):
            cell = row.cells[2 + j]; cell.width = Cm(1.5); cell.text = ''
            pp = cell.paragraphs[0]; set_rtl(pp, WD_ALIGN_PARAGRAPH.CENTER)
            if q['type'] == 'mcq' and j < len(q['options']):
                R(pp.add_run('○'), size=18, color=RGBColor.from_string(tpl['primary']))
            else:
                R(pp.add_run('—'), size=12, color=RGBColor(0xCC,0xCC,0xCC))
    return doc

