def sort_children(parent, order):
    kids = list(parent)
    def key(el):
        tag = el.tag.split('}')[-1]
        return order.index(tag) if tag in order else len(order)
    for el in kids: parent.remove(el)
    for el in sorted(kids, key=key): parent.append(el)

def set_rtl(p, align=WD_ALIGN_PARAGRAPH.RIGHT):
    pPr = p._p.get_or_add_pPr()
    if pPr.find(qn('w:bidi')) is None:
        pPr.append(OxmlElement('w:bidi'))
    p.alignment = align
    sort_children(pPr, PPR_ORDER)

def R(run, name='Arial', size=14, bold=False, color=None, rtl=True):
    run.font.name = name
    run.font.size = Pt(size)
    if bold: run.font.bold = True
    if color is not None: run.font.color.rgb = color
    rPr = run._r.get_or_add_rPr()
    rF = rPr.find(qn('w:rFonts'))
    if rF is None:
        rF = OxmlElement('w:rFonts'); rPr.insert(0, rF)
    for a in ('w:cs', 'w:ascii', 'w:hAnsi'):
        rF.set(qn(a), name)
    if rtl:
        rPr.append(OxmlElement('w:rtl'))
    s = OxmlElement('w:szCs'); s.set(qn('w:val'), str(int(size * 2))); rPr.append(s)
    if bold: rPr.append(OxmlElement('w:bCs'))
    if color is not None:
        c = OxmlElement('w:color'); c.set(qn('w:val'), str(color).upper()); rPr.append(c)
    sort_children(rPr, RPR_ORDER)

def page_border(sec, hex_c, size=24, style='single'):
    sp = sec._sectPr
    if sp.find(qn('w:pgBorders')) is not None: return
    pg = OxmlElement('w:pgBorders'); pg.set(qn('w:offsetFrom'), 'page')
    for e in ('top','left','bottom','right'):
        el = OxmlElement(f'w:{e}')
        el.set(qn('w:val'), style); el.set(qn('w:sz'), str(size))
        el.set(qn('w:space'), '24'); el.set(qn('w:color'), hex_c)
        pg.append(el)
    sp.append(pg)

def shade_cell(cell, fill=None, margins=(80, 100, 80, 100)):
    tcPr = cell._tc.get_or_add_tcPr()
    if fill:
        shd = OxmlElement('w:shd')
        shd.set(qn('w:val'),'clear'); shd.set(qn('w:color'),'auto')
        shd.set(qn('w:fill'), fill); tcPr.append(shd)
    tcM = OxmlElement('w:tcMar')
    for edge, v in zip(['top','left','bottom','right'], margins):
        el = OxmlElement(f'w:{edge}'); el.set(qn('w:w'), str(v))
        el.set(qn('w:type'),'dxa'); tcM.append(el)
    tcPr.append(tcM)
    sort_children(tcPr, TCPR_ORDER)

def remove_table_borders(table):
    tbl = table._tbl
    tblPr = tbl.tblPr
    borders = OxmlElement('w:tblBorders')
    for edge in ('top', 'left', 'bottom', 'right', 'insideH', 'insideV'):
        el = OxmlElement(f'w:{edge}')
        el.set(qn('w:val'), 'none')
        el.set(qn('w:sz'), '0')
        el.set(qn('w:space'), '0')
        el.set(qn('w:color'), 'auto')
        borders.append(el)
    tblPr.append(borders)

def open_file(path):
    try:
        if sys.platform == 'win32': os.startfile(path)
        elif sys.platform == 'darwin': subprocess.call(['open', path])
        else: subprocess.call(['xdg-open', path])
    except Exception as e:
        messagebox.showwarning("تنبيه", f"تعذر فتح الملف:\n{e}")

def _new_doc(tpl, margins=(1.8, 1.8)):
    doc = Document(); s = doc.sections[0]
    s.top_margin = s.bottom_margin = Cm(margins[0])
    s.left_margin = s.right_margin = Cm(margins[1])
    if tpl.get('border_style'):
        page_border(s, tpl['primary'], tpl.get('border_size', 24), tpl.get('border_style', 'single'))
    return doc

