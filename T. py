class QuestionDialog:
    def __init__(self, parent, existing=None):
        self.top = tk.Toplevel(parent)
        self.top.title('إضافة سؤال' if existing is None else 'تعديل سؤال')
        self.top.geometry('600x550'); self.top.transient(parent); self.top.grab_set()
        self.top.configure(bg='#eef2f7'); self.result = None
        
        f = ttk.Frame(self.top, padding=15); f.pack(fill='both', expand=True)
        
        ttk.Label(f, text='عنوان السؤال (مثال: السؤال الأول):').grid(row=0, column=0, sticky='ne', pady=6)
        self.title_entry = ttk.Entry(f, font=('Arial', 11), width=45)
        self.title_entry.grid(row=0, column=1, sticky='we', pady=6)
        
        ttk.Label(f, text='الدرجة (اختياري):').grid(row=1, column=0, sticky='e', pady=6)
        self.marks_entry = ttk.Entry(f, font=('Arial', 11), width=15)
        self.marks_entry.grid(row=1, column=1, sticky='w', pady=6)
        
        ttk.Label(f, text='نص الأسئلة / الفقرة:').grid(row=2, column=0, sticky='ne', pady=6)
        self.body_text = tk.Text(f, height=15, width=50, font=('Arial', 11), wrap='word')
        self.body_text.grid(row=2, column=1, sticky='nsew', pady=6)
        
        btns = ttk.Frame(f); btns.grid(row=3, column=0, columnspan=2, pady=15)
        ttk.Button(btns, text='حفظ', command=self.save).pack(side='right', padx=6)
        ttk.Button(btns, text='إلغاء', command=self.top.destroy).pack(side='right', padx=6)
        
        f.columnconfigure(1, weight=1); f.rowconfigure(2, weight=1)
        
        if existing:
            self.title_entry.insert(0, existing.get('title', ''))
            self.marks_entry.insert(0, str(existing.get('marks', '')))
            self.body_text.insert('1.0', existing.get('body', ''))
            
    def save(self):
        title = self.title_entry.get().strip()
        if not title: return messagebox.showerror('خطأ', 'أدخل عنوان السؤال', parent=self.top)
        q = {'title': title, 'body': self.body_text.get('1.0', 'end').strip()}
        marks_str = self.marks_entry.get().strip()
        if marks_str:
            try: q['marks'] = float(marks_str)
            except: pass
        self.result = q; self.top.destroy()

class QuestionsPanel(ttk.LabelFrame):
    def __init__(self, parent):
        super().__init__(parent, text='  الأسئلة  ', padding=6)
        self.questions = []
        
        bar = ttk.Frame(self); bar.pack(fill='x', pady=3)
        ttk.Button(bar, text='➕ إضافة', command=self.add).pack(side='right', padx=2)
        ttk.Button(bar, text='✏️ تعديل', command=self.edit).pack(side='right', padx=2)
        ttk.Button(bar, text='🗑️ حذف', command=self.delete).pack(side='right', padx=2)
        
        pb = ttk.Frame(self); pb.pack(fill='x', pady=3)
        ttk.Label(pb, text='تحميل نموذج جاهز:').pack(side='right', padx=4)
        self.preset = ttk.Combobox(pb, values=list(PRESET_EXAMS.keys()), state='readonly', width=25)
        self.preset.pack(side='right', padx=4); self.preset.current(0)
        ttk.Button(pb, text='تحميل', command=self.load_preset).pack(side='right', padx=4)
        
        cols = ('num', 'title', 'marks')
        self.tree = ttk.Treeview(self, columns=cols, show='headings', height=5)
        for c, txt, w, a in [('num','#',40,'center'),('title','عنوان السؤال',400,'e'),('marks','الدرجة',60,'center')]:
            self.tree.heading(c, text=txt); self.tree.column(c, width=w, anchor=a)
        self.tree.pack(fill='both', expand=True)
        self.tree.bind('<Double-1>', lambda e: self.edit())

    def add(self):
        d = QuestionDialog(self.winfo_toplevel()); self.winfo_toplevel().wait_window(d.top)
        if d.result: self.questions.append(d.result); self.refresh()
    def edit(self):
        sel = self.tree.selection()
        if not sel: return
        i = int(sel[0])
        d = QuestionDialog(self.winfo_toplevel(), self.questions[i])
        self.winfo_toplevel().wait_window(d.top)
        if d.result: self.questions[i] = d.result; self.refresh()
    def delete(self):
        sel = self.tree.selection()
        if sel and messagebox.askyesno('تأكيد', 'حذف السؤال؟'):
            del self.questions[int(sel[0])]; self.refresh()
    def load_preset(self):
        name = self.preset.get()
        if messagebox.askyesno('تأكيد', f'استبدال الأسئلة بنموذج:\n"{name}"؟'):
            self.questions = [dict(q) for q in PRESET_EXAMS[name]]; self.refresh()
    def refresh(self):
        for i in self.tree.get_children(): self.tree.delete(i)
        for i, q in enumerate(self.questions):
            self.tree.insert('', 'end', iid=str(i), values=(i + 1, q.get('title', '')[:60], q.get('marks', '')))

