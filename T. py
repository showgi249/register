class DocPanel(ttk.Frame):
    def __init__(self, parent, templates, form_builder, doc_builder, filename_prefix='doc'):
        super().__init__(parent)
        self.templates = templates
        self.builder = doc_builder
        self.prefix = filename_prefix
        self.selected_tpl = templates[0]

        ttk.Label(self, text='① اختر القالب', style='Header.TLabel').pack(anchor='e', padx=20, pady=(8, 2))
        self.tpl_var = tk.StringVar(value=templates[0]['name'])
        ttk.Combobox(self, textvariable=self.tpl_var, values=[t['name'] for t in templates], state='readonly', width=30).pack(pady=4)
        
        def on_tpl_change(*args):
            for t in templates:
                if t['name'] == self.tpl_var.get(): self.selected_tpl = t; break
        self.tpl_var.trace('w', on_tpl_change)

        ttk.Label(self, text='② املأ البيانات', style='Header.TLabel').pack(anchor='e', padx=20, pady=(15, 2))
        form_frame = ttk.Frame(self); form_frame.pack(fill='both', expand=True, padx=20, pady=4)
        self.get_data = form_builder(form_frame)

        ttk.Button(self, text='💾  إنشاء الملف (Word / PDF)', style='Accent.TButton', command=self.generate).pack(pady=8)

    def generate(self):
        data = self.get_data()
        if data is None: return
        try: doc = self.builder(data, self.selected_tpl)
        except Exception as e: return messagebox.showerror('خطأ', f'{e}')

        path = filedialog.asksaveasfilename(defaultextension='.docx', filetypes=[('Word Document', '*.docx'), ('PDF Document', '*.pdf')], initialfile=f"{self.prefix}.docx")
        if not path: return
        ext = os.path.splitext(path)[1].lower()

        if ext == '.pdf':
            temp_docx = os.path.splitext(path)[0] + '_tmp.docx'
            try:
                doc.save(temp_docx)
                ok, msg = self.convert_to_pdf(temp_docx, path)
                if os.path.exists(temp_docx): os.remove(temp_docx)
                if ok:
                    if messagebox.askyesno('تم', f'تم الحفظ:\n{path}\n\nفتح؟'): open_file(path)
                else:
                    messagebox.showerror('تعذر', msg)
                    if messagebox.askyesno('حفظ Word؟', 'حفظ بصيغة Word بدلاً من PDF؟'):
                        new_path = os.path.splitext(path)[0] + '.docx'
                        doc.save(new_path)
                        if messagebox.askyesno('تم', f'تم:\n{new_path}\n\nفتح؟'): open_file(new_path)
            except Exception as e: messagebox.showerror('خطأ', f'{e}')
            return

        try:
            if ext != '.docx': path = os.path.splitext(path)[0] + '.docx'
            doc.save(path)
            if messagebox.askyesno('تم', f'تم الحفظ:\n{path}\n\nفتح؟'): open_file(path)
        except Exception as e: messagebox.showerror('خطأ', f'{e}')

    def convert_to_pdf(self, docx_path, pdf_path):
        try:
            from docx2pdf import convert
            convert(docx_path, pdf_path)
            if os.path.exists(pdf_path) and os.path.getsize(pdf_path) > 0: return True, 'docx2pdf'
        except: pass
        lo_paths = ['soffice', 'libreoffice', r'C:\Program Files\LibreOffice\program\soffice.exe']
        for lo in lo_paths:
            try:
                if os.path.sep in lo and not os.path.exists(lo): continue
                subprocess.run([lo, '--version'], capture_output=True, timeout=5)
                out_dir = os.path.dirname(os.path.abspath(pdf_path)) or '.'
                subprocess.run([lo, '--headless', '--convert-to', 'pdf:writer_pdf_Export', '--outdir', out_dir, docx_path], check=True, capture_output=True, timeout=90)
                gen = os.path.join(out_dir, os.path.splitext(os.path.basename(docx_path))[0] + '.pdf')
                if gen != os.path.abspath(pdf_path) and os.path.exists(gen): shutil.move(gen, pdf_path)
                if os.path.exists(pdf_path) and os.path.getsize(pdf_path) > 0: return True, 'LibreOffice'
            except: continue
        return False, 'يرجى تثبيت Word أو LibreOffice.'

