class DocPanel(ttk.Frame):
    def __init__(self, parent, templates, form_builder, doc_builder, is_batch=False, is_cv=False, filename_prefix='doc'):
        super().__init__(parent)
        self.templates = templates; self.builder = doc_builder
        self.prefix = filename_prefix; self.is_batch = is_batch; self.is_cv = is_cv
        self.selected_tpl = templates[0]

        ttk.Label(self, text='① اختر التصميم', style='Header.TLabel').pack(anchor='e', padx=20, pady=(8, 2))
        self.tpl_var = tk.StringVar(value=templates[0]['name'])
        ttk.Combobox(self, textvariable=self.tpl_var, values=[t['name'] for t in templates], state='readonly', width=35).pack(pady=4)
        
        def on_tpl_change(*args):
            for t in templates:
                if t['name'] == self.tpl_var.get(): self.selected_tpl = t; break
        self.tpl_var.trace_add('write', on_tpl_change)

        ttk.Label(self, text='② املأ البيانات', style='Header.TLabel').pack(anchor='e', padx=20, pady=(10, 2))
        form_frame = ttk.Frame(self); form_frame.pack(fill='both', expand=True, padx=20, pady=4)
        self.get_data = form_builder(form_frame)

        btn_frame = ttk.Frame(self); btn_frame.pack(pady=10)
        
        if self.is_cv:
            ttk.Button(btn_frame, text='⚡ تحميل بيانات تجريبية', command=self.load_sample_data).pack(side='left', padx=5)
            
        ttk.Button(btn_frame, text='💾  إنشاء الملف (Word / PDF)', style='Accent.TButton', command=self.generate).pack(side='left', padx=5)
        
        if self.is_batch:
            ttk.Button(btn_frame, text='📂 استيراد أسماء من CSV (توليد دفعة)', style='Accent.TButton', command=self.generate_batch).pack(side='left', padx=5)

    def load_sample_data(self):
        # هذه الدالة سيتم تجاوزها من داخل form_cv
        pass

    def generate(self):
        data = self.get_data()
        if data is None: return
        try: doc = self.builder(data, self.selected_tpl)
        except Exception as e: return messagebox.showerror('خطأ', f'{e}')
        
        path = filedialog.asksaveasfilename(defaultextension='.docx', filetypes=[('Word', '*.docx'), ('PDF', '*.pdf')], initialfile=f"{self.prefix}.docx")
        if not path: return
        ext = os.path.splitext(path)[1].lower()

        if ext == '.pdf':
            temp_docx = os.path.splitext(path)[0] + '_tmp.docx'
            doc.save(temp_docx)
            ok, msg = self.convert_to_pdf(temp_docx, path)
            if os.path.exists(temp_docx): os.remove(temp_docx)
            if ok:
                if messagebox.askyesno('تم', f'تم الحفظ:\n{path}\n\nفتح؟'): open_file(path)
            else:
                messagebox.showerror('تعذر تحويل PDF', msg + '\n\nسيتم حفظ نسخة Word بدلاً من ذلك.')
                doc.save(os.path.splitext(path)[0] + '.docx')
            return

        try:
            doc.save(path)
            if messagebox.askyesno('تم', f'تم الحفظ:\n{path}\n\nفتح؟'): open_file(path)
        except Exception as e: messagebox.showerror('خطأ', f'{e}')

    def generate_batch(self):
        filepath = filedialog.askopenfilename(title="اختر ملف الأسماء (CSV)", filetypes=[("CSV Files", "*.csv")])
        if not filepath: return
        path = filedialog.asksaveasfilename(defaultextension='.docx', filetypes=[('Word', '*.docx')], initialfile="شهادات_دفعة.docx")
        if not path: return
        try:
            with open(filepath, mode='r', encoding='utf-8-sig') as f:
                reader = csv.reader(f)
                names = [row[0] for row in reader if row and row[0].strip()]
            if not names: return messagebox.showerror('خطأ', 'الملف فارغ.')
            doc = Document(); doc._body.clear_content()
            for i, name in enumerate(names):
                data = {'org': 'مدرسة الأمل', 'name': name, 'date': datetime.now().strftime('%Y-%m-%d'), 'body': 'تقديراً لجهودكم المتميزة.'}
                single_doc = self.builder(data, self.selected_tpl)
                for element in single_doc.element.body: doc.element.body.append(element)
                if i < len(names) - 1: doc.add_page_break()
            doc.save(path)
            messagebox.showinfo('نجاح', f'تم توليد {len(names)} شهادة!\n{path}')
            open_file(path)
        except Exception as e: messagebox.showerror('خطأ', f'{e}')

    def convert_to_pdf(self, docx_path, pdf_path):
        try:
            from docx2pdf import convert
            convert(docx_path, pdf_path)
            if os.path.exists(pdf_path): return True, 'docx2pdf'
        except: pass
        for lo in ['soffice', 'libreoffice', r'C:\Program Files\LibreOffice\program\soffice.exe']:
            try:
                if os.path.sep in lo and not os.path.exists(lo): continue
                out_dir = os.path.dirname(os.path.abspath(pdf_path)) or '.'
                subprocess.run([lo, '--headless', '--convert-to', 'pdf', '--outdir', out_dir, docx_path], check=True, capture_output=True, timeout=60)
                gen = os.path.join(out_dir, os.path.splitext(os.path.basename(docx_path))[0] + '.pdf')
                if gen != os.path.abspath(pdf_path) and os.path.exists(gen): shutil.move(gen, pdf_path)
                if os.path.exists(pdf_path): return True, 'LibreOffice'
            except: continue
        return False, 'لم يتم العثور على Word أو LibreOffice.'

