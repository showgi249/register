class App:
    def __init__(self, root):
        self.root = root
        root.title('مُنشئ الوثائق التربوية الشامل — 14 نوع جاهز')
        root.geometry('1120x860'); root.configure(bg='#eef2f7')

        style = ttk.Style(); style.theme_use('clam')
        style.configure('TNotebook.Tab', padding=[18, 8], font=('Arial', 11, 'bold'))
        style.configure('TLabel', background='#eef2f7', font=('Arial', 11))
        style.configure('TButton', font=('Arial', 11, 'bold'), padding=5)
        style.configure('Header.TLabel', font=('Arial', 13, 'bold'),
                        foreground='#1F4E79', background='#eef2f7')
        style.configure('Small.TLabel', font=('Arial', 9),
                        foreground='#666', background='#eef2f7')
        style.configure('Treeview', font=('Arial', 10), rowheight=26)
        style.configure('Treeview.Heading', font=('Arial', 10, 'bold'))
        style.configure('Accent.TButton', font=('Arial', 12, 'bold'),
                        padding=8, foreground='white', background='#1F4E79')

        main = ttk.Notebook(root); main.pack(fill='both', expand=True, padx=8, pady=8)

        # ─── الاختبارات ──────────────────────────────────────
        exams_nb = ttk.Notebook(main); main.add(exams_nb, text='📝 الاختبارات')
        self._add_doc(exams_nb, 'ورقة امتحان', EXAM_TEMPLATES, form_exam,
                      build_exam, 'exam', 'ورقة_امتحان')
        self._add_doc(exams_nb, 'نموذج إجابة', EXAM_TEMPLATES, form_exam,
                      build_answer_key, 'exam', 'نموذج_إجابة')
        self._add_doc(exams_nb, 'ورقة إجابة OMR', EXAM_TEMPLATES, form_exam,
                      build_omr, 'exam', 'ورقة_إجابة')

        # ─── الشهادات ────────────────────────────────────────
        certs_nb = ttk.Notebook(main); main.add(certs_nb, text='🏆 الشهادات')
        for kind, title in [('thanks', 'شكر وتقدير'), ('excellence', 'تفوق'),
                             ('participation', 'مشاركة'), ('completion', 'إتمام')]:
            panel = DocPanel(certs_nb, CERT_TEMPLATES, form_cert,
                             lambda d, t, k=kind: build_cert(d, t, k),
                             kind='cert', filename_prefix=f'شهادة_{title}')
            certs_nb.add(panel, text=title)

        # ─── السجلات ─────────────────────────────────────────
        records_nb = ttk.Notebook(main); main.add(records_nb, text='📋 السجلات')
        self._add_doc(records_nb, 'كشف حضور', RECORD_TEMPLATES, form_attendance,
                      build_attendance, 'record', 'كشف_حضور')
        self._add_doc(records_nb, 'كشف درجات', RECORD_TEMPLATES, form_grades,
                      build_grades, 'record', 'كشف_درجات')
        self._add_doc(records_nb, 'بطاقة تقييم', RECORD_TEMPLATES, form_report_card,
                      build_report_card, 'record', 'بطاقة_تقييم')
        self._add_doc(records_nb, 'جدول حصص', RECORD_TEMPLATES, form_timetable,
                      build_timetable, 'record', 'جدول_حصص')

        # ─── المراسلات ───────────────────────────────────────
        letters_nb = ttk.Notebook(main); main.add(letters_nb, text='📄 المراسلات')
        self._add_doc(letters_nb, 'ترويسة رسمية', LETTER_TEMPLATES, form_letterhead,
                      build_letterhead, 'letter', 'ترويسة_رسمية')
        self._add_doc(letters_nb, 'إعلان مدرسي', LETTER_TEMPLATES, form_notice,
                      build_notice, 'letter', 'إعلان')
        self._add_doc(letters_nb, 'كتاب لأولياء الأمور', LETTER_TEMPLATES,
                      form_parent_letter, build_parent_letter, 'letter', 'كتاب_ولي_أمر')

    def _add_doc(self, nb, title, templates, form, builder, kind, prefix):
        panel = DocPanel(nb, templates, form, builder, kind=kind, filename_prefix=prefix)
        nb.add(panel, text=title)

if __name__ == '__main__':
    root = tk.Tk()
    App(root)
    root.mainloop()