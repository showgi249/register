PPR_ORDER = ['pStyle','keepNext','keepLines','pageBreakBefore','framePr',
             'widowControl','numPr','suppressLineNumbers','pBdr','shd','tabs',
             'suppressAutoHyphens','kinsoku','wordWrap','overflowPunct',
