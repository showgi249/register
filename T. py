class DocPanel(ttk.Frame):
    def __init__(self, parent, templates, form_builder, doc_builder,
                 kind='exam', filename_prefix='document'):
        super().__init__(parent)
        self.templates = templates
        self.builder = doc_builder
        self.prefix = filename_prefix
        self.selected_tpl = templates[0]
        self.cards = []

        ttk.Label(self, text='① اختر القالب',
                  style='Header.TLabel').pack(anchor='e', padx=20, pady=(8, 2))
        gallery = ttk.Frame(self); gallery.pack(pady=4)
        for i, tpl in enumerate(templates):
            card = make_card(gallery, tpl, kind, self.select)
            card.grid(row=0, column=i, padx=4)
            self.cards.append((tpl, card))
        self.highlight()

        ttk.Label(self, text='② املأ البيانات',
                  style='Header.TLabel').pack(anchor='e', padx=20, pady=(8, 2))
        form_frame = ttk.Frame(self); form_frame.pack(fill='both', expand=True,
                                                       padx=20, pady=4)
        self.get_data = form_builder(form_frame)

        ttk.Button(self, text='💾  إنشاء الملف وحفظه كـ Word',
                   style='Accent.TButton',
                   command=self.generate).pack(pady=8)

    def select(self, tpl, frame):
        self.selected_tpl = tpl; self.highlight()

    def highlight(self):
        for tpl, card in self.cards:
            if tpl is self.selected_tpl:
                card.configure(highlightbackground='#' + tpl['primary'],
                               highlightthickness=3)
            else:
                card.configure(highlightbackground='#d0d0d0', highlightthickness=2)

    def generate(self):
        data = self.get_data()
        if data is None: return
        try:
            doc = self.builder(data, self.selected_tpl)
            path = filedialog.asksaveasfilename(
                defaultextension='.docx', filetypes=[('Word Document', '*.docx')],
                initialfile=f"{self.prefix}.docx")
            if not path: return
            doc.save(path)
            if messagebox.askyesno('تم', f'تم الحفظ:\n{path}\n\nفتح الملف؟'):
                open_file(path)
        except Exception as e:
            messagebox.showerror('خطأ', f'{e}')

# ─── Form builders ────────────────────────────────────────────
def _entry(parent, label, default, row, col=0):
    ttk.Label(parent, text=label).grid(row=row, column=col, sticky='e', padx=6, pady=3)
    e = ttk.Entry(parent, font=('Arial', 11))
    e.grid(row=row, column=col + 1, sticky='we', padx=6, pady=3)
    e.insert(0, default); return e

def form_exam(parent):
    parent.columnconfigure(1, weight=1); parent.columnconfigure(3, weight=1)
    f = lambda lbl, d, r, c: _entry(parent, lbl, d, r, c)
    school   = f('اسم المدرسة:', 'مدرسة الأمل', 0, 0)
    subject  = f('المادة:', 'الرياضيات', 0, 2)
    grade    = f('الصف:', 'السادس', 1, 0)
    duration = f('المدة:', 'ساعتان', 1, 2)
    date     = f('التاريخ:', datetime.now().strftime('%Y-%m-%d'), 2, 0)
    total    = f('الدرجة الكلية:', '100', 2, 2)
    qp = QuestionsPanel(parent)
    qp.grid(row=3, column=0, columnspan=4, sticky='we', pady=6)
    def get_data():
        if not qp.questions:
            messagebox.showwarning('تنبيه', 'أضف سؤالاً أو حمّل نموذجاً.'); return None
        return {'school': school.get() or '—', 'subject': subject.get() or '—',
                'grade': grade.get() or '—', 'duration': duration.get() or '—',
                'date': date.get() or '—', 'total': total.get() or '—',
                'questions': qp.questions}
    return get_data

def form_cert(parent):
    parent.columnconfigure(1, weight=1); parent.columnconfigure(3, weight=1)
    org  = _entry(parent, 'اسم الجهة:', 'مدرسة الأمل', 0, 0)
    name = _entry(parent, 'اسم المستفيد:', 'محمد أحمد', 0, 2)
    date = _entry(parent, 'التاريخ:', datetime.now().strftime('%Y-%m-%d'), 1, 0)
    ttk.Label(parent, text='نص الشهادة:').grid(row=2, column=0, sticky='ne', pady=4)
    body = tk.Text(parent, height=5, font=('Arial', 11), wrap='word')
    body.grid(row=2, column=1, columnspan=3, sticky='we', padx=6, pady=4)
    body.insert('1.0', CERT_DEFAULT_BODY['thanks'])
    def get_data():
        return {'org': org.get() or '—', 'name': name.get() or '—',
                'date': date.get() or '—', 'body': body.get('1.0','end').strip()}
    return get_data

def form_record_basic(parent, fields):
    parent.columnconfigure(1, weight=1); parent.columnconfigure(3, weight=1)
    entries = {}
    for i, (key, label, default) in enumerate(fields):
        r, c = i // 2, (i % 2) * 2
        entries[key] = _entry(parent, label, default, r, c)
    return entries

