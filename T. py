# تصميم ورقة الامتحان الاحترافية
# ══════════════════════════════════════════════════════════════
def build_exam(d, tpl):
    doc = _new_doc(tpl)
    pr = RGBColor.from_string(tpl['primary'])
    ac = RGBColor.from_string(tpl['accent'])
    
    # 1. الترويسة (Header) - تصميم جدول مدمج
    header_t = doc.add_table(rows=2, cols=1)
    header_t.alignment = WD_TABLE_ALIGNMENT.CENTER
    header_t.autofit = False
    
    # الصف الأول: اسم المدرسة (خلفية داكنة، نص أبيض)
    c1 = header_t.cell(0, 0)
    c1.width = Cm(17)
    shade_cell(c1, tpl['primary'], (120, 80, 120, 80))
    p = c1.paragraphs[0]; set_rtl(p, WD_ALIGN_PARAGRAPH.CENTER)
    R(p.add_run(d['school']), size=18, bold=True, color=RGBColor(255,255,255))
    
    # الصف الثاني: المادة والصف (خلفية فاتحة، نص داكن)
    c2 = header_t.cell(1, 0)
    c2.width = Cm(17)
    shade_cell(c2, tpl['bg'], (80, 80, 80, 80))
    p = c2.paragraphs[0]; set_rtl(p, WD_ALIGN_PARAGRAPH.CENTER)
    R(p.add_run(f"امتحان مادة: {d['subject']}   |   الصف: {d['grade']}"), size=14, bold=True, color=pr)
    
    doc.add_paragraph()
    
    # 2. بيانات الطالب (Student Info) - جدول نظيف
    info_t = doc.add_table(rows=2, cols=4)
    info_t.alignment = WD_TABLE_ALIGNMENT.CENTER
    info_t.autofit = False
    info_data = [
        ('اسم الطالب:', '', 'رقم الجلوس:', ''),
        ('المدة:', d['duration'], 'التاريخ:', d['date'])
    ]
    for r, row in enumerate(info_data):
        for c, val in enumerate(row):
            cell = info_t.cell(r, c)
            cell.width = Cm(4.25)
            cell.text = ''
            is_key = (c % 2 == 0)
            if is_key: shade_cell(cell, tpl['bg'], (60, 80, 60, 80))
            else: shade_cell(cell, None, (60, 80, 60, 80))
            
            pp = cell.paragraphs[0]
            set_rtl(pp, WD_ALIGN_PARAGRAPH.CENTER)
            if is_key:
                R(pp.add_run(val), size=12, bold=True, color=pr)
            else:
                R(pp.add_run(val if val else '___________________'), size=12)
                
    p = doc.add_paragraph(); set_rtl(p, WD_ALIGN_PARAGRAPH.LEFT)
    R(p.add_run(f"الدرجة الكلية: {d['total']}"), size=14, bold=True, color=ac)
    
    # 3. الأسئلة (Questions)
    for i, q in enumerate(d['questions'], 1):
        doc.add_paragraph()
        # عنوان السؤال (على خلفية ملونة)
        q_title_t = doc.add_table(rows=1, cols=1)
        q_title_t.alignment = WD_TABLE_ALIGNMENT.RIGHT
        q_c = q_title_t.cell(0, 0)
        q_c.width = Cm(17)
        shade_cell(q_c, tpl['bg'], (40, 60, 40, 60))
        p = q_c.paragraphs[0]; set_rtl(p)
        title = q.get('title', f'السؤال {i}')
        R(p.add_run(f" {title} "), size=14, bold=True, color=pr)
        if q.get('marks'):
            R(p.add_run(f"   [{q['marks']} درجات]"), size=12, bold=True, color=ac)
            
        # فقرة الأسئلة
        body = q.get('body', '')
        if body:
            p_body = doc.add_paragraph()
            set_rtl(p_body)
            p_body.paragraph_format.space_before = Pt(8)
            p_body.paragraph_format.right_indent = Cm(0.5)
            p_body.paragraph_format.line_spacing = 1.5
            R(p_body.add_run(body), size=13)

    # 4. التذييل
    doc.add_paragraph()
    p = doc.add_paragraph(); set_rtl(p, WD_ALIGN_PARAGRAPH.CENTER)
    R(p.add_run('— انتهت الأسئلة — بالتوفيق والنجاح —'), size=14, bold=True, color=pr)
    return doc

