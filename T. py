def _entry(parent, label, default, row, col=0):
    ttk.Label(parent, text=label).grid(row=row, column=col, sticky='e', padx=6, pady=3)
    e = ttk.Entry(parent, font=('Arial', 11))
    e.grid(row=row, column=col + 1, sticky='we', padx=6, pady=3)
    e.insert(0, default); return e

def form_exam(parent):
    parent.columnconfigure(1, weight=1); parent.columnconfigure(3, weight=1)
