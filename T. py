class QuestionDialog:
    def __init__(self, parent, existing=None):
        self.top = tk.Toplevel(parent)
        self.top.title('إضافة سؤال' if existing is None else 'تعديل سؤال')
        self.top.geometry('560x640'); self.top.transient(parent); self.top.grab_set()
        self.top.configure(bg='#eef2f7'); self.result = None
        f = ttk.Frame(self.top, padding=15); f.pack(fill='both', expand=True)
        ttk.Label(f, text='نص السؤال:').grid(row=0, column=0, sticky='ne', pady=6)
        self.text = tk.Text(f, height=3, width=42, font=('Arial', 11), wrap='word')
        self.text.grid(row=0, column=1, sticky='we', pady=6)
        ttk.Label(f, text='النوع:').grid(row=1, column=0, sticky='e', pady=6)
        self.qtype = tk.StringVar(value='mcq')
        rbf = ttk.Frame(f); rbf.grid(row=1, column=1, sticky='w')
        ttk.Radiobutton(rbf, text='اختيار متعدد', variable=self.qtype,
                        value='mcq', command=self.toggle).pack(side='right', padx=5)
        ttk.Radiobutton(rbf, text='مقالي', variable=self.qtype,
                        value='essay', command=self.toggle).pack(side='right', padx=5)
        ttk.Label(f, text='الدرجة:').grid(row=2, column=0, sticky='e', pady=6)
        self.marks = ttk.Entry(f, width=15, font=('Arial', 11))
        self.marks.grid(row=2, column=1, sticky='w', pady=6); self.marks.insert(0, '1')
        self.opt_frame = ttk.LabelFrame(f, text='الخيارات (سطر لكل خيار)', padding=6)
        self.opt_frame.grid(row=3, column=0, columnspan=2, sticky='we', pady=6)
        self.options = tk.Text(self.opt_frame, height=4, width=50, font=('Arial', 11))
        self.options.pack(fill='both', expand=True)
        ttk.Label(self.opt_frame, text='رقم الإجابة الصحيحة (0-3):').pack(anchor='e', pady=(4,0))
        self.answer_idx = ttk.Entry(self.opt_frame, width=10, font=('Arial', 11))
        self.answer_idx.pack(anchor='e'); self.answer_idx.insert(0, '0')
        self.essay_frame = ttk.LabelFrame(f, text='الإجابة المقالية', padding=6)
        self.essay_frame.grid(row=4, column=0, columnspan=2, sticky='we', pady=6)
        ttk.Label(self.essay_frame, text='عدد الأسطر:').pack(side='right', padx=5)
        self.essay_lines = ttk.Entry(self.essay_frame, width=8, font=('Arial', 11))
        self.essay_lines.pack(side='right'); self.essay_lines.insert(0, '3')
        ttk.Label(self.essay_frame, text='الإجابة النموذجية:').pack(anchor='e', pady=(4,0))
        self.model_ans = tk.Text(self.essay_frame, height=2, width=50, font=('Arial', 11))
        self.model_ans.pack(fill='x')
        btns = ttk.Frame(f); btns.grid(row=5, column=0, columnspan=2, pady=15)
        ttk.Button(btns, text='حفظ', command=self.save).pack(side='right', padx=6)
        ttk.Button(btns, text='إلغاء', command=self.top.destroy).pack(side='right', padx=6)
        f.columnconfigure(1, weight=1)
        if existing:
            self.text.insert('1.0', existing['text'])
            self.qtype.set(existing['type'])
            self.marks.delete(0, 'end'); self.marks.insert(0, str(existing['marks']))
            if existing['type'] == 'mcq':
                self.options.insert('1.0', '\n'.join(existing.get('options', [])))
                self.answer_idx.delete(0, 'end')
                self.answer_idx.insert(0, str(existing.get('answer', 0)))
            else:
                self.essay_lines.delete(0, 'end')
                self.essay_lines.insert(0, str(existing.get('lines', 3)))
                if existing.get('model_answer'):
                    self.model_ans.insert('1.0', existing['model_answer'])
        self.toggle()

    def toggle(self):
        if self.qtype.get() == 'mcq':
            self.opt_frame.grid(); self.essay_frame.grid_remove()
        else:
            self.opt_frame.grid_remove(); self.essay_frame.grid()

    def save(self):
        text = self.text.get('1.0', 'end').strip()
        if not text: return messagebox.showerror('خطأ', 'أدخل نص السؤال', parent=self.top)
        try: marks = float(self.marks.get())
        except: return messagebox.showerror('خطأ', 'درجة غير صحيحة', parent=self.top)
        q = {'text': text, 'type': self.qtype.get(), 'marks': marks}
        if q['type'] == 'mcq':
            opts = [o.strip() for o in self.options.get('1.0', 'end').splitlines() if o.strip()]
            if len(opts) < 2: return messagebox.showerror('خطأ', 'خياران على الأقل', parent=self.top)
            q['options'] = opts
            try: q['answer'] = int(self.answer_idx.get())
            except: q['answer'] = 0
        else:
            try: q['lines'] = int(self.essay_lines.get())
            except: q['lines'] = 3
            q['model_answer'] = self.model_ans.get('1.0', 'end').strip()
        self.result = q; self.top.destroy()

class QuestionsPanel(ttk.LabelFrame):
    def __init__(self, parent):
        super().__init__(parent, text='  الأسئلة  ', padding=6)
        self.questions = []
        bar = ttk.Frame(self); bar.pack(fill='x', pady=3)
        ttk.Button(bar, text='➕', command=self.add).pack(side='right', padx=2)
        ttk.Button(bar, text='✏️', command=self.edit).pack(side='right', padx=2)
        ttk.Button(bar, text='🗑️', command=self.delete).pack(side='right', padx=2)
        ttk.Button(bar, text='⬆️', command=lambda: self.move(-1)).pack(side='right', padx=2)
        ttk.Button(bar, text='⬇️', command=lambda: self.move(1)).pack(side='right', padx=2)
        pb = ttk.Frame(self); pb.pack(fill='x', pady=3)
        ttk.Label(pb, text='تحميل نموذج:').pack(side='right', padx=4)
        self.preset = ttk.Combobox(pb, values=list(PRESET_EXAMS.keys()),
                                   state='readonly', width=22, font=('Arial', 10))
        self.preset.pack(side='right', padx=4)
        self.preset.current(0)
        ttk.Button(pb, text='تحميل', command=self.load_preset).pack(side='right', padx=4)
        self.total_lbl = ttk.Label(bar, text='المجموع: 0',
                                   font=('Arial', 10, 'bold'), foreground='#C00000')
        self.total_lbl.pack(side='left', padx=4)
        cols = ('num', 'type', 'text', 'marks')
        self.tree = ttk.Treeview(self, columns=cols, show='headings', height=5)
        for c, txt, w, a in [('num','#',40,'center'),('type','النوع',100,'center'),
                              ('text','السؤال',420,'e'),('marks','الدرجة',60,'center')]:
            self.tree.heading(c, text=txt); self.tree.column(c, width=w, anchor=a)
        self.tree.pack(fill='both', expand=True)
        self.tree.bind('<Double-1>', lambda e: self.edit())

    def add(self):
        d = QuestionDialog(self.winfo_toplevel()); self.winfo_toplevel().wait_window(d.top)
        if d.result: self.questions.append(d.result); self.refresh()

    def edit(self):
        sel = self.tree.selection()
        if not sel: return
        i = int(sel[0])
        d = QuestionDialog(self.winfo_toplevel(), self.questions[i])
        self.winfo_toplevel().wait_window(d.top)
        if d.result: self.questions[i] = d.result; self.refresh()

    def delete(self):
        sel = self.tree.selection()
        if sel and messagebox.askyesno('تأكيد', 'حذف السؤال؟'):
            del self.questions[int(sel[0])]; self.refresh()

    def move(self, d):
        sel = self.tree.selection()
        if not sel: return
        i = int(sel[0]); j = i + d
        if 0 <= j < len(self.questions):
            self.questions[i], self.questions[j] = self.questions[j], self.questions[i]
            self.refresh(); self.tree.selection_set(str(j))

    def load_preset(self):
        name = self.preset.get()
        if messagebox.askyesno('تأكيد', f'استبدال الأسئلة بنموذج:\n"{name}"؟'):
            self.questions = [dict(q) for q in PRESET_EXAMS[name]]; self.refresh()

    def refresh(self):
        for i in self.tree.get_children(): self.tree.delete(i)
        total = 0
        for i, q in enumerate(self.questions):
            t = 'اختيار' if q['type'] == 'mcq' else 'مقالي'
            self.tree.insert('', 'end', iid=str(i),
                             values=(i + 1, t, q['text'][:60], q['marks']))
            total += q['marks']
        self.total_lbl.config(text=f'المجموع: {total:g}')

