def build_cv(d, tpl):
    doc = _new_doc(None, margins=(1.5, 1.5))
    pr = RGBColor.from_string(tpl['primary'])
    bg_hex = tpl['accent']
    
    # الدالة المساعدة لتحليل النصوص وإضافة نقاط
    def add_list_items(cell, text):
        for line in text.split('\n'):
            if not line.strip(): continue
            p = cell.add_paragraph(); set_rtl(p)
            p.paragraph_format.space_after = Pt(4)
            R(p.add_run(f"• {line.strip()}"), size=11)

    if tpl['id'] == 'modern':
        # تصميم بعمودين
        table = doc.add_table(rows=1, cols=2)
        table.autofit = False; remove_table_borders(table)
        table.columns[0].width = Cm(12) # العمود الرئيسي (يمين لأن RTL)
        table.columns[1].width = Cm(6)  # العمود الجانبي
        
        c_main = table.cell(0, 0); c_side = table.cell(0, 1)
        
        # --- العمود الجانبي ---
        shade_cell(c_side, bg_hex, (100, 100, 100, 100))
        p = c_side.paragraphs[0]; set_rtl(p, WD_ALIGN_PARAGRAPH.CENTER)
        R(p.add_run(d['name']), size=24, bold=True, color=pr)
        p = c_side.add_paragraph(); set_rtl(p, WD_ALIGN_PARAGRAPH.CENTER)
        R(p.add_run(d['job_title']), size=14, color=RGBColor(100,100,100))
        c_side.add_paragraph()
        
        p = c_side.add_paragraph(); set_rtl(p)
        R(p.add_run("معلومات التواصل"), size=14, bold=True, color=pr)
        p = c_side.add_paragraph(); set_rtl(p)
        R(p.add_run(f"📞 {d['phone']}"), size=11)
        p = c_side.add_paragraph(); set_rtl(p)
        R(p.add_run(f"✉️ {d['email']}"), size=11)
        p = c_side.add_paragraph(); set_rtl(p)
        R(p.add_run(f"📍 {d['address']}"), size=11)
        c_side.add_paragraph()
        
        p = c_side.add_paragraph(); set_rtl(p)
        R(p.add_run("المهارات"), size=14, bold=True, color=pr)
        add_list_items(c_side, d['skills'])
        c_side.add_paragraph()
        
        p = c_side.add_paragraph(); set_rtl(p)
        R(p.add_run("اللغات"), size=14, bold=True, color=pr)
        add_list_items(c_side, d['languages'])
        
        # --- العمود الرئيسي ---
        p = c_main.paragraphs[0]; set_rtl(p)
        R(p.add_run("الملف الشخصي"), size=16, bold=True, color=pr)
        p = c_main.add_paragraph(); set_rtl(p); p.paragraph_format.line_spacing = 1.5
        R(p.add_run(d['summary']), size=11)
        c_main.add_paragraph()
        
        p = c_main.add_paragraph(); set_rtl(p)
        R(p.add_run("الخبرات العملية"), size=16, bold=True, color=pr)
        for line in d['experience'].split('\n'):
            if not line.strip(): continue
            parts = line.split('|')
            if len(parts) >= 3:
                p = c_main.add_paragraph(); set_rtl(p)
                R(p.add_run(parts[0].strip()), size=12, bold=True)
                R(p.add_run(f" | {parts[1].strip()}"), size=11, color=pr)
                R(p.add_run(f" ({parts[2].strip()})"), size=10, color=RGBColor(128,128,128))
            else:
                p = c_main.add_paragraph(); set_rtl(p)
                R(p.add_run(line), size=11)
        c_main.add_paragraph()
        
        p = c_main.add_paragraph(); set_rtl(p)
        R(p.add_run("التعليم"), size=16, bold=True, color=pr)
        for line in d['education'].split('\n'):
            if not line.strip(): continue
            parts = line.split('|')
            if len(parts) >= 3:
                p = c_main.add_paragraph(); set_rtl(p)
                R(p.add_run(parts[0].strip()), size=12, bold=True)
                R(p.add_run(f" | {parts[1].strip()}"), size=11, color=pr)
                R(p.add_run(f" ({parts[2].strip()})"), size=10, color=RGBColor(128,128,128))
            else:
                p = c_main.add_paragraph(); set_rtl(p)
                R(p.add_run(line), size=11)

